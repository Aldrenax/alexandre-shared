[Unit]
Description=Hermes Media Engine - contrôle de santé éditorial
After=alexandre-media-network.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/alexandre-media-engine/current
EnvironmentFile=-/etc/alexandre-media-engine/media-engine.env
ExecStart=/usr/bin/node /opt/alexandre-media-engine/current/bin/media-engine.mjs monitor --json
TimeoutStartSec=2min
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/alexandre-media-engine/current
ReadWritePaths=/var/lib/alexandre-media-engine

