[Unit]
Description=Hermes Media Engine - guides hebdomadaires en brouillon
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/alexandre-media-engine/current
EnvironmentFile=-/etc/alexandre-media-engine/media-engine.env
ExecStart=/usr/bin/node /opt/alexandre-media-engine/current/bin/media-engine.mjs guide --json
TimeoutStartSec=3h
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/alexandre-media-engine/current /var/lib/hermes-agent/business-data
ReadWritePaths=/var/lib/alexandre-media-engine /var/lib/hermes-agent/media-engine
