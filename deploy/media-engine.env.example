# Aucun secret ne doit être placé dans Git.
MEDIA_ENGINE_RUNTIME_DIR=/var/lib/alexandre-media-engine
MEDIA_ENGINE_ASSETS_DIR=/var/lib/hermes-agent/media-engine/assets
MEDIA_ENGINE_PUBLICATION_MODE=draft
MEDIA_ENGINE_AUTOMATIC_PUBLICATION_APPROVED=false
MEDIA_ENGINE_PUSH_ENABLED=false
MEDIA_ENGINE_SHADOW_STARTED_AT=
MEDIA_ENGINE_SHADOW_DAYS_REQUIRED=7
MEDIA_ENGINE_SITES_PATH=/etc/alexandre-media-engine/sites.json
# Les brouillons prêts sont publiés rapidement entre 07:00 et 21:00 Europe/Paris.
MEDIA_ENGINE_PUBLISH_START_HOUR=7
MEDIA_ENGINE_PUBLISH_END_HOUR=21

# Agrégats produits par le Studio, sans token ni session navigateur.
MEDIA_ENGINE_OFFERS_PATH=/var/lib/hermes-agent/business-data/studio-affiliate-offers.json
MEDIA_ENGINE_GUIDE_OPPORTUNITIES_PATH=/var/lib/hermes-agent/business-data/studio-guide-opportunities.json
MEDIA_ENGINE_INTERNAL_LINKS_PATH=/var/lib/hermes-agent/business-data/studio-internal-links.json

# Proxy résidentiel protégé utilisé par yt-dlp pour les transcriptions YouTube.
HTTP_PROXY_URL=

# ChatGPT via l'authentification OAuth OpenAI Codex de Hermes.
HERMES_EDITORIAL_PROVIDER=openai-codex
HERMES_EDITORIAL_MODEL=gpt-5.6-terra
HERMES_GUIDE_MODEL=
HERMES_RESEARCH_MODEL=
HERMES_IMAGE_ORCHESTRATOR_MODEL=
HERMES_CONTAINER=hermes-agent
HERMES_BIN=/opt/hermes/.venv/bin/hermes
HERMES_TELEGRAM_TOPIC_STATE_PATH=/var/lib/hermes-agent/telegram-cockpit/state.json

# Fourni par l'environnement protégé existant, jamais dans ce fichier exemple.
TELEGRAM_CHAT_ID=
