# Aucun secret ne doit être placé dans Git.
MEDIA_ENGINE_RUNTIME_DIR=/var/lib/alexandre-media-engine
MEDIA_ENGINE_ASSETS_DIR=/var/lib/hermes-agent/media-engine/assets
MEDIA_ENGINE_PUBLICATION_MODE=draft
MEDIA_ENGINE_AUTOMATIC_PUBLICATION_APPROVED=false
MEDIA_ENGINE_PUSH_ENABLED=false
MEDIA_ENGINE_SHADOW_STARTED_AT=
MEDIA_ENGINE_SHADOW_DAYS_REQUIRED=7
MEDIA_ENGINE_SITES_PATH=/etc/alexandre-media-engine/sites.json
# Les brouillons prêts sont publiés rapidement entre 07:00 et 21:00 Europe/Paris.
MEDIA_ENGINE_PUBLISH_START_HOUR=7
MEDIA_ENGINE_PUBLISH_END_HOUR=21
# Cadence de publication validée. Ce sont des plafonds, jamais des objectifs :
# les preuves, la QA et les garde-fous restent prioritaires.
# Réseau : 10 articles/jour au total, dont au plus 8 Actualités, au plus 2
# Actualités supplémentaires après la première de chaque média, et 2 contenus
# non-Actualités (Vidéos + Guides), avec 60 minutes entre deux publications.
# Média : 2 articles/jour au total, dont au plus 2 Actualités, 1 Vidéo et
# 1 contenu non-Actualité ;
# les Guides restent limités à 1 par fenêtre glissante de 7 jours et deux
# publications du même média sont espacées d'au moins 4 heures.
MEDIA_ENGINE_PUBLICATION_DAILY_LIMIT=10
MEDIA_ENGINE_PUBLICATION_NEWS_DAILY_LIMIT=8
MEDIA_ENGINE_PUBLICATION_EXTRA_NEWS_DAILY_LIMIT=2
MEDIA_ENGINE_PUBLICATION_NON_NEWS_DAILY_LIMIT=2
MEDIA_ENGINE_PUBLICATION_PER_MEDIA_DAILY_LIMIT=2
MEDIA_ENGINE_NEWS_PER_MEDIA_DAILY_LIMIT=2
MEDIA_ENGINE_NON_NEWS_PER_MEDIA_DAILY_LIMIT=1
MEDIA_ENGINE_VIDEO_PER_MEDIA_DAILY_LIMIT=1
MEDIA_ENGINE_GUIDE_PER_MEDIA_WEEKLY_LIMIT=1
MEDIA_ENGINE_PUBLICATION_MIN_INTERVAL_MINUTES=60
MEDIA_ENGINE_PUBLICATION_PER_MEDIA_MIN_INTERVAL_MINUTES=240
MEDIA_ENGINE_NEWS_MAX_AGE_HOURS=72
MEDIA_ENGINE_VIDEO_LOOKBACK_DAYS=7

# Agrégats produits par le Studio, sans token ni session navigateur.
MEDIA_ENGINE_OFFERS_PATH=/var/lib/hermes-agent/business-data/studio-affiliate-offers.json
MEDIA_ENGINE_GUIDE_OPPORTUNITIES_PATH=/var/lib/hermes-agent/business-data/studio-guide-opportunities.json
MEDIA_ENGINE_INTERNAL_LINKS_PATH=/var/lib/hermes-agent/business-data/studio-internal-links.json

# Proxy résidentiel protégé utilisé par yt-dlp pour les transcriptions YouTube.
HTTP_PROXY_URL=
YTDLP_ATTEMPTS=3
YTDLP_ALLOW_DIRECT_FALLBACK=true
WHISPER_MODEL=base
WHISPER_COMPUTE=int8
WHISPER_CPU_THREADS=2
WHISPER_CHUNK_SECONDS=30
WHISPER_TRANSCRIPT_CACHE_DIR=/var/lib/alexandre-media-engine/cache/transcripts

# ChatGPT via l'authentification OAuth OpenAI Codex de Hermes.
HERMES_EDITORIAL_PROVIDER=openai-codex
HERMES_EDITORIAL_MODEL=gpt-5.6-terra
HERMES_GUIDE_MODEL=
HERMES_RESEARCH_MODEL=
HERMES_IMAGE_ORCHESTRATOR_MODEL=
# Une seule reprise textuelle sûre et bornée pour les écarts QA réparables.
# Valeurs admises par le moteur : 0 à 2. Les erreurs de preuve restent bloquées.
MEDIA_ENGINE_QA_REPAIR_ATTEMPTS=1
# X/Grok enrichit les RSS et sources officielles, il ne les remplace jamais.
# Budget SuperGrok par défaut : une recherche officielle par média, une fois par semaine.
MEDIA_ENGINE_X_SEARCH_ENABLED=true
MEDIA_ENGINE_X_SEARCH_OFFICIAL_ONLY=true
MEDIA_ENGINE_X_SEARCH_MAX_QUERIES=6
MEDIA_ENGINE_X_SEARCH_INTERVAL_HOURS=168
MEDIA_ENGINE_X_SEARCH_QUOTA_COOLDOWN_HOURS=168
HERMES_CONTAINER=hermes-agent
HERMES_BIN=/opt/hermes/.venv/bin/hermes
HERMES_DOCKER_USER=10000:10000
HERMES_TELEGRAM_TOPIC_STATE_PATH=/var/lib/hermes-agent/telegram-cockpit/state.json

# Fourni par l'environnement protégé existant, jamais dans ce fichier exemple.
TELEGRAM_CHAT_ID=

# Attribution newsletter : service local shadow, séparé de Systeme.io.
# Le secret HMAC est généré sur le VPS par activate-newsletter-shadow.sh.
NEWSLETTER_SHADOW_MODE=shadow
NEWSLETTER_SHADOW_HOST=127.0.0.1
NEWSLETTER_SHADOW_PORT=8097
