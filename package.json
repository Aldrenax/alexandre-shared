    "newsletter:shadow": "node bin/newsletter-shadow-server.mjs"
  },
  "bin": {
    "alexandre-media-engine": "./bin/media-engine.mjs"
  },
  "type": "module",
  "exports": {
    "./style-guide": "./STYLE_GUIDE_BASE.md",
    "./lib/seo.mjs": "./lib/seo.mjs",
    "./lib/utm.mjs": "./lib/utm.mjs",
    "./lib/youtube.mjs": "./lib/youtube.mjs",
    "./lib/whisper.mjs": "./lib/whisper.mjs",
    "./media/registry.mjs": "./media/registry.mjs",
    "./media/source-collector.mjs": "./media/source-collector.mjs",
    "./media/candidates.mjs": "./media/candidates.mjs",
    "./media/hermes-client.mjs": "./media/hermes-client.mjs",
    "./media/editorial.mjs": "./media/editorial.mjs",
    "./media/guide-planner.mjs": "./media/guide-planner.mjs",
    "./media/qa.mjs": "./media/qa.mjs",
    "./media/state-store.mjs": "./media/state-store.mjs",
    "./media/telegram.mjs": "./media/telegram.mjs",
    "./media/site-publisher.mjs": "./media/site-publisher.mjs",
    "./media/publication-worker.mjs": "./media/publication-worker.mjs",
    "./media/wordpress-draft-publisher.mjs": "./media/wordpress-draft-publisher.mjs",
    "./media/preflight.mjs": "./media/preflight.mjs",
    "./media/newsletter-attribution.mjs": "./media/newsletter-attribution.mjs",
    "./media/engine.mjs": "./media/engine.mjs"
  },
  "dependencies": {
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.3",
    "youtubei.js": "^17.0.0"
  },
  "files": [
    "bin/",
    "config/",
    "deploy/",
    "docs/",
    "media/",
    "STYLE_GUIDE_BASE.md",
    "lib/"
  ],
  "repository": {
